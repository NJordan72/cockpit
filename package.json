{
  "name": "cockpit",
  "version": "0.1.0",
  "private": true,
  "description": "A macOS terminal host for Claude Code and Codex, with agent status, an activity log, and a sandboxed widget sidebar",
  "license": "MIT",
  "author": "Nick Jordan (https://github.com/NJordan72)",
  "homepage": "https://github.com/NJordan72/cockpit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NJordan72/cockpit.git"
  },
  "bugs": {
    "url": "https://github.com/NJordan72/cockpit/issues"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "postinstall": "install-electron && electron-rebuild -f -o node-pty",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test",
    "smoke": "node scripts/smoke.mjs",
    "package": "electron-vite build && electron-builder --config electron-builder.config.ts --mac --publish never",
    "package:app": "electron-vite build && electron-builder --config electron-builder.config.ts --mac --dir --publish never",
    "changeset": "changeset"
  },
  "trustedDependencies": [
    "electron",
    "node-pty",
    "esbuild"
  ],
  "dependencies": {
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1",
    "@changesets/cli": "3",
    "@electron/rebuild": "4",
    "@eslint/js": "9",
    "@types/node": "26",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@vitejs/plugin-react": "6",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "44",
    "electron-builder": "26",
    "electron-vite": "6",
    "eslint": "9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "react": "19",
    "react-dom": "19",
    "typescript": "~7.0.0",
    "typescript-eslint": "^8.71.2",
    "vite": "8",
    "vitest": "^5.0.4"
  }
}
