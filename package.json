{
  "name": "cockpit",
  "version": "0.1.0",
  "private": true,
  "description": "Personal Electron terminal host for Claude Code and Codex, with a sandboxed widget sidebar",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "postinstall": "install-electron && electron-rebuild -f -o node-pty",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test"
  },
  "trustedDependencies": [
    "electron",
    "node-pty",
    "esbuild"
  ],
  "dependencies": {
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "4",
    "@eslint/js": "9",
    "@types/node": "24",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@vitejs/plugin-react": "6",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "44",
    "electron-vite": "6",
    "eslint": "9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "react": "19",
    "react-dom": "19",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.2",
    "vite": "8",
    "vitest": "^5.0.4"
  }
}
