{
  "name": "cockpit",
  "version": "0.3.1",
  "private": true,
  "description": "A macOS terminal host for Claude Code and Codex, with agent status, an activity log, and a sandboxed widget sidebar",
  "license": "MIT",
  "author": "Nick Jordan (https://github.com/NJordan72)",
  "homepage": "https://github.com/NJordan72/cockpit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NJordan72/cockpit.git"
  },
  "bugs": {
    "url": "https://github.com/NJordan72/cockpit/issues"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "lint": "eslint . --max-warnings 0",
    "lint:actions": "actionlint && zizmor .github",
    "lint:shell": "git ls-files -z '*.sh' | xargs -0 shellcheck",
    "test": "bun test --parallel",
    "verify": "bun check --no-script && bun run lint && bun run lint:actions && bun run lint:shell && bun fmt --check --no-script && bun run test",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "smoke": "node scripts/smoke.mjs",
    "package": "electron-vite build && electron-builder --config electron-builder.config.ts --mac --publish never",
    "package:app": "electron-vite build && electron-builder --config electron-builder.config.ts --mac --dir --publish never",
    "changeset": "changeset",
    "version-packages": "changeset version && bun fmt --no-script CHANGELOG.md"
  },
  "trustedDependencies": [
    "electron",
    "node-pty",
    "esbuild"
  ],
  "dependencies": {
    "electron-updater": "6",
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1",
    "@changesets/cli": "3",
    "@eslint/js": "10",
    "@types/bun": "1",
    "@types/node": "24",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@vitejs/plugin-react": "6",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "45",
    "electron-builder": "26",
    "electron-vite": "6",
    "eslint": "10",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "marked": "18",
    "playwright-core": "^1.64.1",
    "react": "19",
    "react-dom": "19",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.2",
    "vite": "8"
  }
}
