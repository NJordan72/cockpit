<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- V8 needs these under the hardened runtime. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- An ad-hoc signature has no team ID, so library validation would refuse the app's own frameworks. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Lets programs in a pane send Apple Events (osascript), after macOS asks. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
  </dict>
</plist>
